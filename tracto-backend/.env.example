SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
ANTHROPIC_API_KEY=your_anthropic_api_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
ENVIRONMENT=development
PORT=8000

# Sentinel Hub (Copernicus Data Space) — S1 e S2
SENTINEL_CLIENT_ID=your_sentinel_client_id
SENTINEL_CLIENT_SECRET=your_sentinel_client_secret

# Up42 Marketplace — imagens de alta resolução (Pléiades, SPOT, Satellogic)
# Obter em: https://console.up42.com → Projects → API Credentials
UP42_PROJECT_ID=your_up42_project_id
UP42_PROJECT_API_KEY=your_up42_project_api_key
