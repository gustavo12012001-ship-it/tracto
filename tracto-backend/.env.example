# Backend FastAPI na Vercel - NAO commite .env com valores reais
# Configure estas variaveis diretamente em Vercel > Environment Variables.

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
# Secret JWT do Supabase (Settings > API > JWT Settings > JWT Secret).
# Se configurado, o backend valida JWT localmente sem round-trip ao Supabase Auth.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
AUTH_CACHE_TTL_SECONDS=60

# Sentinel Hub / Copernicus
SENTINEL_CLIENT_ID=your_sentinel_client_id
SENTINEL_CLIENT_SECRET=your_sentinel_client_secret
SENTINEL_INSTANCE_ID=your_sentinel_instance_id

# Planet
PLANET_API_KEY=your_planet_api_key

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=TEST-your_mercado_pago_token
MERCADO_PAGO_WEBHOOK_SECRET=your_webhook_hmac_secret

# Z-API (WhatsApp) - DESABILITADO POR PADRÃO NA VENDA. Use ENABLE_WHATSAPP=true para ativar.
# ZAPI_INSTANCE_ID=your_zapi_instance_id
# ZAPI_TOKEN=your_zapi_token
# ZAPI_CLIENT_TOKEN=your_zapi_client_token
# ZAPI_WEBHOOK_SECRET=your_zapi_webhook_secret
ENABLE_WHATSAPP=false

# reCAPTCHA
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Acesso total de dono/admin (ignora plano). Separe por virgula.
OWNER_EMAILS=
OWNER_USER_IDS=

# CORS / URLs (substitua your-domain.com pelo domínio final)
ALLOWED_ORIGINS=https://your-domain.com,http://localhost:5173,http://localhost:5174
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://your-domain.com

# Ambiente
ENVIRONMENT=production
PORT=8000

# VAPID (Web Push)
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_CLAIMS_EMAIL=tracto@tracto.app

# Observabilidade - Sentry (opcional). Sem DSN, fica desativado.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Migrations - connection string do Postgres do Supabase.
# Settings > Database > Connection string > URI. NUNCA commite o valor real.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Redis opcional para cache/entitlements compartilhados.
# Sem REDIS_URL, usa cache local em memoria.
REDIS_URL=
