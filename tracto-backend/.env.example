# ============================================================
# Tracto Backend — Variáveis de ambiente
# Copie para .env e preencha. NUNCA commitar .env (pre-commit bloqueia).
# ============================================================

# Core
ENVIRONMENT=development
PORT=8000
APP_VERSION=2.4.0

# Supabase (banco + auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role_key
SUPABASE_ANON_KEY=eyJ...anon_key

# IA (Anthropic Claude)
ANTHROPIC_API_KEY=sk-ant-api03-...

# reCAPTCHA (anti-bot no signup/login)
RECAPTCHA_SECRET_KEY=6Lc...

# Sentinel Hub (Copernicus Data Space) — S1 e S2
SENTINEL_CLIENT_ID=your_sentinel_client_id
SENTINEL_CLIENT_SECRET=your_sentinel_client_secret

# Up42 Marketplace (opcional — imagens alta resolução)
UP42_PROJECT_ID=your_up42_project_id
UP42_PROJECT_API_KEY=your_up42_project_api_key

# ── Mercado Pago (billing) ──────────────────────────────────
# Pegue em https://www.mercadopago.com.br/developers/panel
# Use TEST-... pra sandbox, APP_USR-... pra produção.
MERCADO_PAGO_ACCESS_TOKEN=TEST-1234567890-abc...
# Webhook secret (configurar em Painel MP → Notificações → Webhooks)
MERCADO_PAGO_WEBHOOK_SECRET=hexstring32chars

# URLs públicas (frontend redireciona, MP envia webhook)
FRONTEND_URL=https://tracto-eta.vercel.app
BACKEND_URL=https://tracto-production.up.railway.app

# WhatsApp via Z-API (opcional)
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# CORS (opcional — sobrescreve whitelist default)
# ALLOWED_ORIGINS=https://tracto-eta.vercel.app,https://tractoagro.com.br
# ALLOWED_ORIGINS_REGEX=^https://tracto-[a-z0-9-]+\.vercel\.app$
