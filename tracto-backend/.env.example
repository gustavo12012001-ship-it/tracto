# Backend (FastAPI/Railway) — NAO commite .env com valores reais
# Configure estas variaveis diretamente no Railway > Variables

# Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-PLACEHOLDER

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# Sentinel Hub (Copernicus)
SENTINEL_CLIENT_ID=your_sentinel_client_id
SENTINEL_CLIENT_SECRET=your_sentinel_client_secret

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=TEST-your_mercado_pago_token
MERCADO_PAGO_WEBHOOK_SECRET=your_webhook_hmac_secret

# Z-API (WhatsApp)
ZAPI_INSTANCE_ID=your_zapi_instance_id
ZAPI_TOKEN=your_zapi_token
ZAPI_CLIENT_TOKEN=your_zapi_client_token
# Valida autenticidade dos webhooks recebidos da Z-API
ZAPI_WEBHOOK_SECRET=your_zapi_webhook_secret

# reCAPTCHA
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# CORS / URLs
ALLOWED_ORIGINS=https://tracto-eta.vercel.app,http://localhost:5173
FRONTEND_URL=https://tracto-eta.vercel.app
BACKEND_URL=https://tracto-production.up.railway.app

# Ambiente
# IMPORTANTE: em producao, setar ENVIRONMENT=production via Railway Variables
ENVIRONMENT=development
PORT=8000

# VAPID (Web Push)
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_CLAIMS_EMAIL=seu@email.com
