# Backend (FastAPI/Railway) — NAO commite .env com valores reais
# Configure estas variaveis diretamente no Railway > Variables

# Anthropic
ANTHROPIC_API_KEY=sk-ant-api03-PLACEHOLDER

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
# (A-04) Secret JWT do Supabase (Settings > API > JWT Settings > JWT Secret).
# Se configurado, o backend valida o JWT LOCALMENTE (assinatura HS256 + exp +
# audience) sem round-trip ao Supabase Auth a cada request. Recomendado em prod.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
# (A-04) TTL do cache token->user quando a validacao local nao esta disponivel.
AUTH_CACHE_TTL_SECONDS=60

# Sentinel Hub (Copernicus)
SENTINEL_CLIENT_ID=your_sentinel_client_id
SENTINEL_CLIENT_SECRET=your_sentinel_client_secret

# Mercado Pago
MERCADO_PAGO_ACCESS_TOKEN=TEST-your_mercado_pago_token
MERCADO_PAGO_WEBHOOK_SECRET=your_webhook_hmac_secret

# Z-API (WhatsApp)
ZAPI_INSTANCE_ID=your_zapi_instance_id
ZAPI_TOKEN=your_zapi_token
ZAPI_CLIENT_TOKEN=your_zapi_client_token
# Valida autenticidade dos webhooks recebidos da Z-API
ZAPI_WEBHOOK_SECRET=your_zapi_webhook_secret

# reCAPTCHA
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Acesso total de DONO/ADMIN (ignora plano). Separe por vírgula.
# Pode usar e-mails e/ou user_ids do Supabase. Também há uma lista fixa no
# código (DEFAULT_OWNER_EMAILS em services/billing_service.py).
OWNER_EMAILS=
OWNER_USER_IDS=

# CORS / URLs
ALLOWED_ORIGINS=https://tracto-eta.vercel.app,http://localhost:5173
FRONTEND_URL=https://tracto-eta.vercel.app
BACKEND_URL=https://tracto-production.up.railway.app

# Ambiente
# IMPORTANTE: em producao, setar ENVIRONMENT=production via Railway Variables
ENVIRONMENT=development
PORT=8000

# VAPID (Web Push)
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_CLAIMS_EMAIL=seu@email.com

# (A-10) Observabilidade — Sentry (opcional). Sem DSN, fica desativado.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# (A-08) Migrations — connection string do Postgres do Supabase.
# Settings > Database > Connection string > URI. NUNCA commite o valor real.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# (A-03) Redis opcional p/ cache/entitlements compartilhados entre instâncias.
# Sem REDIS_URL, usa cache local em memória (modo single-instance).
REDIS_URL=
