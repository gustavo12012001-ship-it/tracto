# Frontend (Vite) — copie para .env na raiz do projeto
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
VITE_API_URL=http://127.0.0.1:8000

# (A-10) Sentry frontend (opcional). Sem DSN, observabilidade fica desativada.
# Para ativar: `npm i @sentry/react` e defina o DSN abaixo no Vercel.
VITE_SENTRY_DSN=
# Versão exibida nos eventos do Sentry (opcional).
VITE_APP_VERSION=
